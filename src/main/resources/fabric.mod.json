{
  "schemaVersion": 1,
  "id": "friendlyguard",
  "version": "${version}",
  "name": "FriendlyGuard",
  "description": "Prevent friendly fire on your friends. Add players to a protected list and you will not be able to hit them.",
  "authors": [
    "i777"
  ],
  "contact": {
    "discord": "https://discord.gg/i777"
  },
  "license": "MIT",
  "icon": "assets/friendlyguard/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.friendlyguard.FriendlyGuardClient"
    ],
    "modmenu": [
      "com.friendlyguard.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "friendlyguard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": [
      ">=1.21 <=1.21.11",
      "1.21.x",
      ">=1.21"
    ],
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
